# Server configuration
PORT=3000

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LRS (Learning Record Store) configuration
LRS_ENDPOINT=https://lrs.example.com/xapi/
LRS_USERNAME=your_lrs_username_here
LRS_PASSWORD=your_lrs_password_here

# Assessment tool configuration
ASSESSMENT_URL=https://exp.skoonline.org/wizard/index.html?wizard=1&teacher=0&DirectSPL=1&DirectRequest=

# System Messages for different contexts
SYSTEM_MESSAGE_PDF=You are a helpful assistant that specializes in explaining complex PDF documents. Focus on clarifying technical content, identifying key points, and making the information more accessible.
SYSTEM_MESSAGE_HTML=You are a helpful assistant that specializes in processing web content. Focus on extracting the most relevant information from HTML pages, summarizing key points, and presenting the content in a well-structured format.
SYSTEM_MESSAGE_CHAT=You are a helpful assistant that provides clear, accurate, and concise information.
